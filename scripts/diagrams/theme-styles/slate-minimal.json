{
  "theme": "slate-minimal",
  "name": "Slate Minimal",
  "mode": "light",
  "fontFamily": "'Caladea', 'Poppins', 'Noto Sans JP', serif",
  "colors": {
    "primary": "#475569",
    "primaryDark": "#111111",
    "primaryLight": "#E2E8F0",
    "primaryPale": "#F8FAFC",
    "accent": "#111111",
    "text": "#334155",
    "textMuted": "#6B7280",
    "background": "#FFFFFF",
    "surface": "#FFFFFF",
    "border": "#CBD5E1",
    "borderLight": "#F1F5F9",
    "line": "#475569",
    "success": "#64748B",
    "warning": "#94A3B8",
    "danger": "#475569"
  },
  "mermaid": {
    "theme": "base",
    "themeVariables": {
      "primaryColor": "#F8FAFC",
      "primaryTextColor": "#334155",
      "primaryBorderColor": "#475569",
      "lineColor": "#475569",
      "secondaryColor": "#E2E8F0",
      "tertiaryColor": "#FFFFFF",
      "mainBkg": "#F8FAFC",
      "nodeBorder": "#475569",
      "clusterBkg": "#FFFFFF",
      "clusterBorder": "#CBD5E1",
      "titleColor": "#111111",
      "edgeLabelBackground": "#FFFFFF",
      "fontFamily": "'Caladea', 'Poppins', 'Noto Sans JP', serif",
      "fontSize": "15px"
    },
    "flowchart": {
      "curve": "basis",
      "padding": 10,
      "nodeSpacing": 40,
      "rankSpacing": 50
    },
    "sequence": {
      "actorFontSize": 14,
      "messageFontSize": 14,
      "noteFontSize": 13,
      "actorLineColor": "#475569",
      "messageColor": "#475569"
    },
    "fontSize": 15
  },
  "drawio": {
    "primaryNodeStyle": "rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#334155;strokeWidth=1.5;",
    "accentNodeStyle": "rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#111111;fontColor=#FFFFFF;fontStyle=1;",
    "secondaryNodeStyle": "rounded=0;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#334155;",
    "containerStyle": "swimlane;startSize=28;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#111111;fontStyle=1;",
    "edgeStyle": "edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;"
  },
  "shapes": {
    "nodeRadius": 4,
    "nodeRadiusLg": 8,
    "markerRadius": 2,
    "strokeWidth": 1.5,
    "strokeWidthBold": 2.5,
    "nodePaddingX": 12,
    "nodePaddingY": 8
  },
  "effects": {
    "nodeShadowEnabled": false,
    "nodeShadowColor": "rgba(0, 0, 0, 0.05)",
    "nodeShadowBlur": 0,
    "nodeShadowOffsetY": 0,
    "glowEnabled": false,
    "glowColor": null,
    "glowBlur": 0,
    "glassEnabled": false,
    "glassFill": null,
    "glassStroke": null
  },
  "typography": {
    "titleSize": 22,
    "labelSize": 15,
    "captionSize": 12,
    "titleWeight": "bold",
    "labelWeight": "normal"
  },
  "signature": {
    "source": "themes/slate-minimal.css",
    "gradientFrom": "#475569",
    "gradientTo": "#E2E8F0",
    "topBorderWidth": 0,
    "hasGlass": false,
    "hasGlow": false
  }
}
