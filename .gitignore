# Agent skill installs are local-only and gitignored, EXCEPT .github/skills
# which is tracked so GitHub Copilot uses the same skills in cloud/CI.
# (Do not use `.github/*` wildcard here — it would silently ignore
#  `.github/skills` and any future .github config.)
.kiro
.agent
.agents
.windsurf
.codex
.claude

.venv
venv

**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage

node_modules/
.dist/

pytest-results.xml

# Take-screenshots scratch output (scripts/take-screenshots.py)
_*_temp.html
_list_temp.html
