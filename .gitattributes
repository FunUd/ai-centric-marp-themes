# Binary assets: keep line-ending conversion and diff off.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Generated slide HTML under slides/ stays diffable (no binary flag).
slides/**/*.html diff linguist-generated

# SVG diagrams are text (LF) so golden comparisons stay stable on Windows.
*.svg text eol=lf diff

# Screenshots are regenerable via `python scripts/take-screenshots.py all`.
# Uncomment to use Git LFS if clone size becomes a problem:
# assets/screenshots/*.png filter=lfs diff=lfs merge=lfs -text
# assets/fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
